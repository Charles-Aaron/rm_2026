prefix=${pcfiledir}/../../../
libdir=${prefix}/lib/x86_64-linux-gnu
includedir=${prefix}/include/ignition/physics5

Name: Ignition physics bullet-plugin
Description: A set of physics bullet-plugin classes for robot applications
Version: ignition-cmake2 >= 1.1 5.3.2
Requires: ignition-physics5 = 5.3.2
Requires.private: 
Libs: -L${libdir} -lignition-physics5-bullet-plugin 
Libs.private: 
CFLags: -I${includedir} 
