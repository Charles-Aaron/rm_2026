prefix=${pcfiledir}/../../../
libdir=${prefix}/lib/x86_64-linux-gnu
includedir=${prefix}/include/ignition/sensors6

Name: Ignition sensors
Description: A set of sensors classes for robot applications
Version: 6.8.0
Requires: ignition-cmake2 >= 1.1 protobuf >=  ignition-math6 ignition-common4 ignition-transport11 ignition-rendering6 ignition-msgs8 sdformat12
Requires.private: 
Libs: -L${libdir} -lignition-sensors6 
Libs.private: 
CFlags: -I${includedir} -std=c++14
