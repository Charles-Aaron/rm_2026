prefix=${pcfiledir}/../../../
libdir=${prefix}/lib/x86_64-linux-gnu
includedir=${prefix}/include/ignition/rendering6

Name: Ignition rendering ogre
Description: A set of rendering ogre classes for robot applications
Version: ignition-cmake2 >= 1.1 6.6.3
Requires: gl ignition-rendering6 = 6.6.3
Requires.private: 
Libs: -L${libdir} -lignition-rendering6-ogre 
Libs.private: -lOgreMain
CFLags: -I${includedir} 
