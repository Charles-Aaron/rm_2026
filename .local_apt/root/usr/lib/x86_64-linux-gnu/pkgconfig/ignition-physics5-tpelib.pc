prefix=${pcfiledir}/../../../
libdir=${prefix}/lib/x86_64-linux-gnu
includedir=${prefix}/include/ignition/physics5

Name: Ignition physics tpelib
Description: A set of physics tpelib classes for robot applications
Version: ignition-cmake2 >= 1.1 5.3.2
Requires: ignition-common4 ignition-physics5 = 5.3.2
Requires.private: 
Libs: -L${libdir} -lignition-physics5-tpelib 
Libs.private: 
CFLags: -I${includedir} 
