prefix=${pcfiledir}/../../../
libdir=${prefix}/lib/x86_64-linux-gnu
includedir=${prefix}/include/ignition/plugin1

Name: Ignition plugin
Description: A set of plugin classes for robot applications
Version: 1.4.0
Requires: ignition-cmake2 >= 1.1 
Requires.private: 
Libs: -L${libdir} -lignition-plugin1 
Libs.private: 
CFlags: -I${includedir} -std=c++17
