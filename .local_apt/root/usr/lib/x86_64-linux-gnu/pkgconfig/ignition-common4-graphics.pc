prefix=${pcfiledir}/../../../
libdir=${prefix}/lib/x86_64-linux-gnu
includedir=${prefix}/include/ignition/common4

Name: Ignition common graphics
Description: A set of common graphics classes for robot applications
Version: ignition-cmake2 >= 1.1 4.7.0
Requires: ignition-math6 ignition-utils1 ignition-common4 = 4.7.0
Requires.private: tinyxml2 gts
Libs: -L${libdir} -lignition-common4-graphics 
Libs.private: -lfreeimage
CFLags: -I${includedir} 
