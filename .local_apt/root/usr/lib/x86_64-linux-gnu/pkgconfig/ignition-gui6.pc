prefix=${pcfiledir}/../../../
libdir=${prefix}/lib/x86_64-linux-gnu
includedir=${prefix}/include/ignition/gui6

Name: Ignition gui
Description: A set of gui classes for robot applications
Version: 6.8.0
Requires: ignition-cmake2 >= 1.1 protobuf >= 3 ignition-math6 ignition-common4 ignition-plugin1 ignition-transport11 ignition-rendering6 ignition-msgs8 Qt5Core Qt5Quick Qt5QuickControls2 Qt5Widgets
Requires.private: tinyxml2
Libs: -L${libdir} -lignition-gui6 
Libs.private: 
CFlags: -I${includedir} -std=c++17
