prefix=${pcfiledir}/../../../
libdir=${prefix}/lib/x86_64-linux-gnu
includedir=${prefix}/include/ignition/sensors6

Name: Ignition sensors depth_camera
Description: A set of sensors depth_camera classes for robot applications
Version: ignition-cmake2 >= 1.1 6.8.0
Requires: ignition-sensors6 = 6.8.0
Requires.private: 
Libs: -L${libdir} -lignition-sensors6-depth_camera 
Libs.private: 
CFLags: -I${includedir} 
