prefix=${pcfiledir}/../../../
libdir=${prefix}/lib/x86_64-linux-gnu
includedir=${prefix}/include/ignition/gazebo6

Name: Ignition gazebo rendering
Description: A set of gazebo rendering classes for robot applications
Version: ignition-cmake2 >= 1.1 6.16.0
Requires: ignition-gazebo6 = 6.16.0
Requires.private: 
Libs: -L${libdir} -lignition-gazebo6-rendering 
Libs.private: 
CFLags: -I${includedir} 
