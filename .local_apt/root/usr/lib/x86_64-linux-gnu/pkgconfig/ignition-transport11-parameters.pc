prefix=${pcfiledir}/../../../
libdir=${prefix}/lib/x86_64-linux-gnu
includedir=${prefix}/include/ignition/transport11

Name: Ignition transport parameters
Description: A set of transport parameters classes for robot applications
Version: ignition-cmake2 >= 1.1 11.4.1
Requires: ignition-transport11 = 11.4.1
Requires.private: 
Libs: -L${libdir} -lignition-transport11-parameters 
Libs.private: 
CFLags: -I${includedir} 
