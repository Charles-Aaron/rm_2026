<?xml version="1.0" encoding="UTF-8"?>

<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <ReactiveSequence name="总入口：同步数据并检查比赛状态">
      <Action ID="TopicsToBlackboard" name="读取裁判和机器人状态到黑板"/>
      <Condition ID="GameStatusSub" name="只在比赛进行阶段运行"
                 start_status="4" max_data_age_ms="1000"/>

      <SequenceStar name="开局初始化一次后进入主循环">
        <SequenceWithMemory name="开局初始化：直接去巡逻点1">
          <Action ID="SetNavSpeedAction" name="开局巡逻速度设为2.5米每秒"
                  speed_mps="2.5"/>
          <RetryUntilSuccessful name="最多重试10次导航到巡逻点1"
                                num_attempts="10">
            <Action ID="SendGoalAction" name="开局导航到巡逻点1"
                   goal_pose="4.5; 1.5; 0; 0; 0; 0; 1"
                   action_name="navigate_to_pose"
                   goal_timeout_sec="30"/>
          </RetryUntilSuccessful>
        </SequenceWithMemory>

        <Repeat name="主循环：持续执行保守策略" num_cycles="1000000">
          <ReactiveSequence name="每次循环：刷新数据并检查比赛状态">
            <Action ID="TopicsToBlackboard" name="主循环读取最新状态到黑板"/>
            <Condition ID="GameStatusSub" name="主循环确认比赛仍在进行"
                       start_status="4" max_data_age_ms="1000"/>

            <ReactiveFallback name="优先级选择：补给、增益点、终局、巡逻">
              <SequenceWithMemory name="优先级1：低血低弹时回补给">
                <Condition ID="NeedSupply" name="判断当前是否触发补给条件"
                           enter_hp="150" enter_ammo="40"
                           exit_hp="400" exit_ammo="50"
                           require_game_start="true"/>
                <Action ID="SwitchPoseAction" name="回补给前切换为防御姿态"
                        target_pose="防御姿态"/>
                <Action ID="SetNavSpeedAction" name="回补给速度设为3.0米每秒"
                        speed_mps="3.0"/>
                <RetryUntilSuccessful name="最多重试10次导航到补给点"
                                      num_attempts="10">
                  <Action ID="SendGoalAction" name="导航到补给点"
                         goal_pose="0.0; 0.0; 0; 0; 0; 0; 1"
                         action_name="navigate_to_pose"
                         goal_timeout_sec="25"/>
                </RetryUntilSuccessful>
                <RetryUntilSuccessful name="持续等待补给完成"
                                      num_attempts="1000000">
                  <Condition ID="RecoveredEnough" name="补给后确认血量弹量足够"
                             min_hp="400" min_ammo="50"/>
                </RetryUntilSuccessful>
                <Action ID="SetNavSpeedAction" name="补给后返回速度设为2.5米每秒"
                        speed_mps="2.5"/>
                <RetryUntilSuccessful name="最多重试10次返回巡逻点1"
                                      num_attempts="10">
                  <Action ID="SendGoalAction" name="补给后返回巡逻点1"
                         goal_pose="4.5; 1.5; 0; 0; 0; 0; 1"
                         action_name="navigate_to_pose"
                         goal_timeout_sec="30"/>
                </RetryUntilSuccessful>
              </SequenceWithMemory>

              <SequenceWithMemory name="优先级2：队友阵亡后守增益点">
                <Condition ID="AlliesDown" name="判断1号3号4号队友是否全部阵亡"/>
                <Action ID="SwitchPoseAction" name="守增益点前切换为防御姿态"
                        target_pose="防御姿态"/>
                <Action ID="SetNavSpeedAction" name="前往增益点速度设为2.5米每秒"
                        speed_mps="2.5"/>
                <RetryUntilSuccessful name="最多重试10次导航到增益点"
                                      num_attempts="10">
                  <Action ID="SendGoalAction" name="导航到基地增益点"
                         goal_pose="1.0; -0.5; 0; 0; 0; 0; 1"
                         action_name="navigate_to_pose"
                         goal_timeout_sec="25"/>
                </RetryUntilSuccessful>
                <Action ID="GuardFortress" name="到达后持续守卫增益点"/>
              </SequenceWithMemory>

              <SequenceWithMemory name="优先级3：终局阶段回基地防守">
                <Condition ID="LateGameDecision" name="判断是否进入终局回防条件"/>
                <Action ID="SwitchPoseAction" name="回基地前切换为防御姿态"
                        target_pose="防御姿态"/>
                <Action ID="SetNavSpeedAction" name="回基地速度设为2.0米每秒"
                        speed_mps="2.0"/>
                <RetryUntilSuccessful name="最多重试10次导航到基地防守点"
                                      num_attempts="10">
                  <Action ID="SendGoalAction" name="导航到基地防守点"
                         goal_pose="-1.0; 2.0; 0; 0; 0; 0; 1"
                         action_name="navigate_to_pose"
                         goal_timeout_sec="30"/>
                </RetryUntilSuccessful>
              </SequenceWithMemory>

              <SequenceWithMemory name="优先级4：默认CSV巡逻">
                <Action ID="LoadWaypoints" name="读取保守巡逻点CSV"
                       waypoint_file="conservative_patrol.csv"
                       frame_id="map"
                       waypoints="{patrol_waypoints}"
                       wait_times="{patrol_wait_times}"
                       total_waypoints="{patrol_total_wp}"
                       wp_idx="{patrol_wp_idx}"/>
                <Repeat name="巡逻循环：反复执行所有巡逻点"
                        num_cycles="1000000">
                  <SequenceWithMemory name="执行一个巡逻点">
                    <Action ID="GetCurrentWaypoint" name="取出当前巡逻目标点"
                           waypoints="{patrol_waypoints}"
                           wait_times="{patrol_wait_times}"
                           wp_idx="{patrol_wp_idx}"
                           current_goal="{current_patrol_goal}"
                           current_goal_pose="{current_patrol_goal_pose}"
                           current_wait_sec="{current_patrol_wait_sec}"/>
                    <Action ID="SetNavSpeedAction" name="巡逻速度设为2.0米每秒"
                            speed_mps="2.0"/>
                    <RetryUntilSuccessful name="最多重试10次导航到当前巡逻点"
                                          num_attempts="10">
                      <Action ID="SendGoalAction" name="导航到当前巡逻点"
                             goal_pose="{current_patrol_goal_pose}"
                             action_name="navigate_to_pose"
                             goal_timeout_sec="30"/>
                    </RetryUntilSuccessful>
                    <Action ID="WaitUntilReached" name="等待机器人进入目标0.6米范围"
                           goal_pose="{current_patrol_goal}"
                           tolerance="0.6"
                           global_frame="map"
                           robot_frame="gimbal_yaw_fake"/>
                    <Action ID="WaitDuration" name="按CSV配置在巡逻点停留"
                            duration_sec="{current_patrol_wait_sec}"/>
                    <Action ID="NextWaypoint" name="切换到下一个巡逻点"
                           wp_idx="{patrol_wp_idx}"
                           total_waypoints="{patrol_total_wp}"/>
                  </SequenceWithMemory>
                </Repeat>
              </SequenceWithMemory>
            </ReactiveFallback>
          </ReactiveSequence>
        </Repeat>
      </SequenceStar>
    </ReactiveSequence>
  </BehaviorTree>
</root>
