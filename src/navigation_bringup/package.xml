<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>navigation_bringup</name>
  <version>0.1.0</version>
  <description>Integrated x_sentry sensor, LIO, TF and standalone navigation launch files.</description>
  <maintainer email="x_sentry@example.com">x_sentry</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>frame_broadcaster</exec_depend>
  <exec_depend>initial_pose</exec_depend>
  <exec_depend>livox_ros_driver2</exec_depend>
  <exec_depend>frontend</exec_depend>
  <exec_depend>localization_interfaces</exec_depend>
  <exec_depend>scan_context_relocalization</exec_depend>
  <exec_depend>odom_frame_adapter</exec_depend>
  <exec_depend>cloud_frame_adapter</exec_depend>
  <exec_depend>cmd_vel_relay</exec_depend>
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>sentry_nav</exec_depend>
  <exec_depend>sentry_terrain</exec_depend>
  <exec_depend>sentry_nav_rviz</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
