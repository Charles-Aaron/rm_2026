        chassis_link:
          Value: true
        imu_link:
          Value: true
        imu_odom:
          Value: true
        lidar_link:
          Value: true
        map:
          Value: true
        odom:
          Value: true
      Marker Scale: 0.6000000238418579
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        map:
          odom:
            imu_odom:
              imu_link:
                chassis_link:
                  {}
                lidar_link:
