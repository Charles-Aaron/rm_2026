Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 35; 35; 40
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 30
      Color: 120; 120; 120
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/TF
      Name: Chassis Pose
      Enabled: true
      Frames:
        All Enabled: true
      Marker Scale: 0.5
      Show Axes: true
      Show Names: true
      Show Arrows: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Mapping Cloud
      Enabled: true
      Topic:
        Value: /x_sentry/mapping_backend/runtime_map
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Position Transformer: XYZ
      Color Transformer: AxisColor
      Axis: Z
      Alpha: 1
      Style: Points
      Size (Pixels): 2
      Size (m): 0.03
      Decay Time: 0
      Queue Size: 1
      Use Fixed Frame: true
    - Class: rviz_default_plugins/Path
      Name: Optimized Path
      Enabled: true
      Topic:
        Value: /x_sentry/mapping_backend/optimized_path
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Color: 255; 180; 30
      Line Style: Lines
      Line Width: 0.03
      Pose Style: None
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 20
      Pitch: 0.8
      Yaw: 0.8
      Target Frame: <Fixed Frame>
Window Geometry:
  Width: 1280
  Height: 900
