<?xml version="1.0" encoding="UTF-8"?>

<root main_tree_to_execute="MainTree">

  <BehaviorTree ID="MainTree">

    <ReactiveSequence>

      <!-- 0. 等待比赛开始信号 (start_status = 4) -->
      <Condition ID="GameStatusSub" start_status="4"/>

      <Fallback>

        <!-- 优先级1: 攻击前哨站 -->
        <Sequence name="attack_outpost">
          <Condition ID="OutpostAttack"/>
          <Condition ID="RobotStatusSub" is_status_ok="true"/>
          <Action ID="SwitchPoseAction" target_pose="进攻姿态"/>
          <Action ID="SimVisualizationMove" move_type="attack" linear_speed="0.5" move_duration="2.0"/>
        </Sequence>

        <!-- 优先级2: 英雄保护点 -->
        <Sequence name="protect_hero">
          <Condition ID="HeroProtectAttack"/>
          <Condition ID="RobotStatusSub" is_status_ok="true"/>
          <Action ID="SwitchPoseAction" target_pose="防御姿态"/>
          <Action ID="SimVisualizationMove" move_type="defense" linear_speed="0.5" move_duration="2.0"/>
        </Sequence>

        <!-- 优先级3: 智能补给 -->
        <Sequence name="smart_supply">
          <Action ID="NeedSupply"/>
          <Action ID="SwitchPoseAction" target_pose="移动姿态"/>
          <Action ID="SimVisualizationMove" move_type="patrol" linear_speed="0.5" move_duration="2.0"/>
        </Sequence>

        <!-- 优先级4: 终局策略 -->
        <Sequence name="endgame_strategy">
          <Condition ID="RecoveredEnough"/>
          <Action ID="SwitchPoseAction" target_pose="移动姿态"/>
          <Action ID="SimVisualizationMove" move_type="patrol" linear_speed="0.5" move_duration="2.0"/>
        </Sequence>

        <!-- 优先级5: 守卫基地 (己方输出机阵亡) -->
        <Sequence name="fortress_buff">
          <Condition ID="AlliesDown"/>
          <Action ID="SwitchPoseAction" target_pose="防御姿态"/>
          <Action ID="SimVisualizationMove" move_type="defense" linear_speed="0.5" move_duration="2.0"/>
          <Action ID="GuardFortress"/>
        </Sequence>

        <!-- 优先级6: 巡逻 (保底) -->
        <Sequence name="patrol">
          <Action ID="SwitchPoseAction" target_pose="移动姿态"/>
          <Action ID="SimVisualizationMove" move_type="patrol" linear_speed="0.5" move_duration="2.0"/>
          <Action ID="RandomPatrolPose" 
                  pose1="2;2;0;0;0;0;1" 
                  pose2="3;1;0;0;0;0;1" 
                  pose3="1;3;0;0;0;0;1"/>
        </Sequence>

      </Fallback>

    </ReactiveSequence>

  </BehaviorTree>

</root>
